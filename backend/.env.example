# Copy to backend/.env (gitignored) and fill in real values. Never commit .env.

# --- Database: pick ONE block ---

# Option A: Supabase (primary) - use the Session pooler connection, port 5432
DB_URL=jdbc:postgresql://<pooler-host>.pooler.supabase.com:5432/postgres
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=

# Option B: local Docker Postgres (backup) - run `docker compose up -d postgres` first
# DB_URL=jdbc:postgresql://localhost:5432/handoff
# DB_USERNAME=handoff
# DB_PASSWORD=handoff

# --- Email (PIN) - first configured sender wins: webhook, then Resend, then SMTP ---
MAIL_WEBHOOK_URL=
MAIL_USERNAME=
MAIL_PASSWORD=
