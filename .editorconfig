root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.py]
indent_size = 4

# Matches formatter-maven-plugin (Eclipse default) so VS Code's Java formatter agrees with ./mvnw verify.
[*.java]
indent_size = 4

[Makefile]
indent_style = tab
